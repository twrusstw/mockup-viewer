{
  "name": "mockup-viewer",
  "version": "0.0.1",
  "description": "Dev-only Obsidian plugin to render HTML mockups for UI prototyping",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs development",
    "dev:watch": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "build:dev": "node esbuild.config.mjs development",
    "lint": "tsc --noEmit && eslint \"{src,tests}/**/*.ts\" \"*.config.ts\"",
    "lint:fix": "eslint \"{src,tests}/**/*.ts\" \"*.config.ts\" --fix && tsc --noEmit --pretty",
    "lint:css": "stylelint styles.css",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "twrusstw",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^4.1.7",
    "esbuild": "^0.28.0",
    "eslint": "^9.24.0",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "obsidian": "latest",
    "stylelint": "^17.11.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.29.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "highlight.js": "^11.11.1"
  }
}
